<?xml version="1.0"?>
<package format="3">
  <name>mower_supervisor</name>
  <version>0.1.0</version>
  <description>Slow down or stop a mower when the GPS reading is too poor for the gap to a tree or a wall.</description>
  <maintainer email="moabkh917@gmail.com">Mohammad Khan</maintainer>
  <license>MIT</license>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <export><build_type>ament_python</build_type></export>
</package>
